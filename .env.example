# SmartPark configuration. Copy to `.env` and adjust as needed.
# Every variable maps 1:1 to a field in app/config.py (API) or an env read in
# camera_service/main.py (camera).

# ─── API service (app/) ──────────────────────────────────────────────────

# Filesystem path to the supplied Ultralytics weights. Mounted at runtime;
# never baked into the image. In docker-compose this is /models/model.pt.
MODEL_PATH=./model/model.pt

# Minimum detection confidence passed to model.predict().
CONFIDENCE_THRESHOLD=0.25

# Max concurrent predictions on the shared model. Must be 1 (assignment rule).
MODEL_MAX_CONCURRENCY=1

# Number of simulated car parks. Must be between 10 and 99 (inclusive).
# Keep this identical for the API and the camera service.
NUM_CARPARKS=24

# Base URL of the camera simulator. Locally: http://localhost:8001.
# In docker-compose the services talk over the network as http://camera:8001.
CAMERA_BASE_URL=http://localhost:8001

# Per-request timeout (seconds) for a single camera HTTP call.
HTTP_TIMEOUT_SECONDS=10.0

# Sliding window (seconds) for the "recent UUIDs" operational view.
UUID_WINDOW_SECONDS=30

# Best-effort startup check that the camera service agrees on NUM_CARPARKS.
# Logs an ERROR on mismatch; never blocks or fails startup.
VERIFY_CAMERA_CARPARK_COUNT=true

# --- Caching (spec 4.3: "repeated requests from the same user can be cached")
# TTL (seconds) for cached find-carparks responses, keyed by (uuid, n).
# Set to 0 to disable caching entirely - do this when benchmarking raw
# inference throughput with Locust, otherwise repeat traffic is served for free.
CACHE_TTL_SECONDS=5
# Maximum cached responses held at once (bounded so a flood of distinct uuids
# cannot grow the cache without limit).
CACHE_MAX_ENTRIES=1024

# Persistence backend for statuses + UUID sightings.
#   memory    — process-local; correct only for a SINGLE pod / local dev.
#   firestore — shared store; REQUIRED once you run multiple API pods.
# Uses Application Default Credentials (no JSON key). On Cloud Run / GKE the
# attached service account needs the roles/datastore.user role.
REPOSITORY_BACKEND=memory
# Firestore database id created in the console (leave as the default).
FIRESTORE_DATABASE=(default)
# Optional: force a specific project. Normally leave unset — ADC supplies it.
# FIRESTORE_PROJECT=my-gcp-project

# Logging
SERVICE_NAME=smartpark-api
LOG_LEVEL=INFO

# ─── Camera service (camera_service/) ────────────────────────────────────

# Directory holding the supplied JPEGs. Mounted at runtime; never baked in.
# In docker-compose this is /images.
IMAGES_DIR=./images
